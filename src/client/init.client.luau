-- one sheet at a time: the garage / store, the goals and the city map close each other
Hud.onGoals = function()
	CityMap.close()
	Goals.toggle()
end
Hud.onMenu = function()
	Goals.close()
	CityMap.close()
end
Hud.onMap = CityMap.toggle
Hud.mapOpen = CityMap.isOpen
CityMap.onOpen = function()
	Hud.closeSheets()
	Goals.close()
	Settings.close()
end
Drive.start()
Cockpit.start()
Hud.start()
Guide.start()
TutorialOffer.start()
Goals.start()
Challenges.onOpenGoals = function()
	CityMap.close()
	Goals.open()
end
Challenges.start()
CityMap.start()
PinnedGoals.start()
